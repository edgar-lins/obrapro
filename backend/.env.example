# ── Banco de Dados ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/obrapro

# ── Autenticação ──────────────────────────────────────────────────────────────
# Gerar um segredo forte: openssl rand -hex 32
JWT_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Encontrar em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# ID do preço recorrente (produto Pro R$39/mês) criado no Stripe Dashboard
STRIPE_PRICE_ID=price_...

# Obter após configurar o webhook em: https://dashboard.stripe.com/webhooks
# Em dev, usar: stripe listen --forward-to localhost:8080/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# URLs de redirecionamento após checkout
STRIPE_SUCCESS_URL=https://app.obrapro.com/planos?success=1
STRIPE_CANCEL_URL=https://app.obrapro.com/planos?canceled=1
